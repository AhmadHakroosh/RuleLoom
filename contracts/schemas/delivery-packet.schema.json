{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/delivery-packet.schema.json",
  "title": "Delivery Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticketId",
    "baseSha",
    "headSha",
    "requirementsRef",
    "designRef",
    "changeSummary",
    "filesChanged",
    "acceptanceEvidence",
    "checks",
    "residualRisks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ticketId": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/sha" },
    "headSha": { "$ref": "#/$defs/sha" },
    "requirementsRef": { "type": "string", "minLength": 1 },
    "designRef": { "type": "string", "minLength": 1 },
    "changeSummary": { "type": "string", "minLength": 1 },
    "filesChanged": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "residualRisks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "evidence"],
      "properties": {
        "criterionId": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not-applicable"] },
        "details": { "type": "string" }
      }
    }
  }
}
