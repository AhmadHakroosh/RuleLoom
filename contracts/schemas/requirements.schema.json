{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/requirements.schema.json",
  "title": "Normalized Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ticket",
    "objective",
    "scope",
    "requirements",
    "acceptanceCriteria",
    "ambiguities"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ticket": { "$ref": "#/$defs/reference" },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out"],
      "properties": {
        "in": { "$ref": "#/$defs/nonEmptyStrings" },
        "out": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "actors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "url"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]+$" },
        "kind": { "enum": ["functional", "nonfunctional"] },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then", "requirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^REQ-[0-9]+$" }
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "impact", "blocking"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["low", "medium", "high"] },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
