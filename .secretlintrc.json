{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "assignment-style credentials",
            "patterns": [
              "/password\\s*=\\s*(?<password>[^\\s]{12,})/i",
              "/api[_-]?key\\s*=\\s*(?<apikey>[^\\s]{12,})/i",
              "/token\\s*=\\s*(?<token>[^\\s]{16,})/i"
            ]
          }
        ]
      }
    },
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ]
}
