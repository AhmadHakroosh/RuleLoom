{
  "name": "ruleloom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "install:clean": "pnpm install --frozen-lockfile",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run build && vitest run",
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean && node scripts/clean.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs"
  },
  "devDependencies": {
    "@ruleloom/compiler": "workspace:*",
    "@ruleloom/core": "workspace:*",
    "@ruleloom/runtime": "workspace:*",
    "@ruleloom/schema": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
